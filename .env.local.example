# 本地開發環境變數範例
# 複製此文件為 .env 並填入您的設定

# 資料庫連接 (本地 PostgreSQL)
DATABASE_URL="postgresql://twstock_user:your_password@localhost:5432/twstock?schema=public"

# NextAuth 設定
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-generated-by-openssl"

# 郵件設定 (Gmail 範例)
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-16-digit-app-password"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT="587"
EMAIL_FROM="your-email@gmail.com"

# Cron 任務密鑰
CRON_SECRET="your-random-cron-secret"

# 應用程式 URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 每日郵件設定
DAILY_EMAIL_TIME="16:00"
DAILY_EMAIL_TIMEZONE="Asia/Taipei"
